# 复制为 .env 并按需修改（.env 已被 .gitignore 忽略）
MYSQL_ROOT_PASSWORD=shanheng123
REDIS_PASSWORD=ruoyi123

# 本地构建使用默认 shanheng；生产改为镜像仓库前缀，如 ghcr.io/yourname/healthyapp
IMAGE_PREFIX=shanheng

# 华为账号服务（Account Kit）授权码登录：AppID 即 client_id，AppSecret 即 client_secret
# 在 AGC「项目设置 → 应用信息」看 AppID；“API 管理/应用详情”生成 AppSecret（仅显示一次）
SHANHENG_HUAWEI_CLIENT_ID=
SHANHENG_HUAWEI_CLIENT_SECRET=

# 百度 AI 菜品识别（食物拍照识别）：百度智能云「菜品识别」应用 API Key / Secret Key
SHANHENG_BAIDU_API_KEY=
SHANHENG_BAIDU_SECRET_KEY=